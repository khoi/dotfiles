{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

mise_bin="{{ .chezmoi.homeDir }}/.local/bin/mise"

export PATH="{{ .chezmoi.homeDir }}/.local/bin:$PATH"

test -n "{{ include "dot_config/mise/modify_config.toml" | sha256sum }}"
test -n "{{ include "dot_config/mise/mise.lock" | sha256sum }}"

if [ "${CI:-}" = "true" ]; then
  "$mise_bin" bootstrap packages apply --manager brew --yes
  "$mise_bin" bootstrap packages apply --manager brew-cask --dry-run
  "$mise_bin" bootstrap macos defaults apply --yes
  "$mise_bin" install --yes --locked
else
  "$mise_bin" bootstrap packages apply --manager brew --yes

  set --
  while IFS= read -r package; do
    if [ -n "$package" ] && { ! command -v brew >/dev/null 2>&1 || ! brew list --cask "$package" >/dev/null 2>&1; }; then
      set -- "$@" "brew-cask:$package"
    fi
  done <<EOF
$("$mise_bin" config get --file "{{ .chezmoi.homeDir }}/.config/mise/config.toml" bootstrap.packages | sed -n 's/^"brew-cask:\([^"]*\)".*/\1/p')
EOF

  if [ "$#" -gt 0 ]; then
    "$mise_bin" bootstrap packages apply --yes "$@"
  fi

  "$mise_bin" bootstrap macos defaults apply --yes
  "$mise_bin" bootstrap user apply --yes
  "$mise_bin" install --yes --locked
fi
{{ end -}}
