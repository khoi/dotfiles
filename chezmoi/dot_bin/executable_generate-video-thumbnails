#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s nullglob
shopt -s inherit_errexit 2>/dev/null || true

usage() {
  cat <<'EOF'
Usage: generate-video-thumbnails [options] <input>

Options:
  -o, --output PATH
  -n, --count INT                default: 20
  -c, --columns INT              default: 4
      --rows INT                 default: ceil(count / columns)
      --start VALUE              default: 5.5%%
      --end VALUE                default: 94.5%%
      --padding INT              default: 2
      --margin INT               default: 2
      --background COLOR         default: white
      --thumb-width INT
      --thumb-height INT
  -q, --quality INT              default: 92
      --format auto|jpg|jpeg|png|webp
                                 default: auto
      --hwaccel none|videotoolbox
                                 default: none
      --ffmpeg PATH              default: ffmpeg in PATH
      --ffprobe PATH             default: ffprobe in PATH
      --magick PATH              default: magick in PATH
      --overwrite
      --print-command
      --verbose
  -h, --help

Example:
  fd -I -t f -e mov -e mp4 -e mkv -e avi -e webm -e m4v -j8 -x generate-video-thumbnails --overwrite -o {}.jpg {}
EOF
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

require_arg() {
  [[ $# -ge 2 ]] || die "missing value for $1"
}

is_positive_int() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

is_non_negative_int() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

is_quality() {
  is_positive_int "$1" && ((10#$1 <= 100))
}

resolve_time() {
  local value="$1"
  local duration="$2"
  awk -v value="$value" -v duration="$duration" '
    function fail() {
      exit 64
    }
    function number(text) {
      return text ~ /^[0-9]+([.][0-9]+)?$/
    }
    function parse_clock(text, count, parts) {
      count = split(text, parts, ":")
      if (count == 1) {
        if (!number(parts[1])) fail()
        return parts[1] + 0
      }
      if (count == 2) {
        if (!number(parts[1]) || !number(parts[2]) || parts[2] >= 60) fail()
        return (parts[1] + 0) * 60 + (parts[2] + 0)
      }
      if (count == 3) {
        if (!number(parts[1]) || !number(parts[2]) || !number(parts[3]) || parts[2] >= 60 || parts[3] >= 60) fail()
        return (parts[1] + 0) * 3600 + (parts[2] + 0) * 60 + (parts[3] + 0)
      }
      fail()
    }
    BEGIN {
      if (value ~ /%$/) {
        sub(/%$/, "", value)
        if (!number(value) || (value + 0) > 100) fail()
        printf "%.12f\n", duration * ((value + 0) / 100)
        exit 0
      }
      printf "%.12f\n", parse_clock(value)
    }
  ' || die "invalid time value: $value"
}

count_rows() {
  local count="$1"
  local columns="$2"
  awk -v count="$count" -v columns="$columns" 'BEGIN { printf "%d\n", int((count + columns - 1) / columns) }'
}

ffprobe_duration() {
  local ffprobe_bin="$1"
  local input="$2"
  "$ffprobe_bin" -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$input"
}

format_timestamp() {
  local start="$1"
  local duration="$2"
  local count="$3"
  local item="$4"
  awk -v start="$start" -v duration="$duration" -v count="$count" -v item="$item" '
    BEGIN {
      seconds = start + duration * (item + 0.5) / count
      milliseconds = int(seconds * 1000 + 0.5)
      hours = int(milliseconds / 3600000)
      minutes = int(milliseconds / 60000) % 60
      whole_seconds = int(milliseconds / 1000) % 60
      printf "%02d:%02d:%02d.%03d\n", hours, minutes, whole_seconds, milliseconds % 1000
    }
  '
}

format_from_output() {
  local explicit_format="$1"
  local output="$2"
  if [[ "$explicit_format" != "auto" ]]; then
    printf '%s\n' "$explicit_format"
    return
  fi
  case "${output##*.}" in
  jpg | jpeg | png | webp) printf '%s\n' "${output##*.}" ;;
  *) printf 'jpg\n' ;;
  esac
}

default_output() {
  local input="$1"
  local format="$2"
  if [[ "$format" == "auto" || "$format" == "jpg" || "$format" == "jpeg" ]]; then
    printf '%s.jpg\n' "$input"
    return
  fi
  printf '%s.%s\n' "$input" "$format"
}

input=
output=
count=20
columns=4
rows=
start_value='5.5%'
end_value='94.5%'
padding=2
margin=2
background='white'
thumb_width=
thumb_height=
quality=92
format='auto'
hwaccel='none'
ffmpeg_bin="${FFMPEG_BIN:-$(command -v ffmpeg || true)}"
ffprobe_bin="${FFPROBE_BIN:-$(command -v ffprobe || true)}"
magick_bin="${MAGICK_BIN:-$(command -v magick || true)}"
overwrite=0
print_command=0
verbose=0

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
  -o | --output)
    require_arg "$@"
    output="$2"
    shift 2
    ;;
  -n | --count)
    require_arg "$@"
    is_positive_int "$2" || die "--count must be greater than 0"
    count="$2"
    shift 2
    ;;
  -c | --columns)
    require_arg "$@"
    is_positive_int "$2" || die "--columns must be greater than 0"
    columns="$2"
    shift 2
    ;;
  --rows)
    require_arg "$@"
    is_positive_int "$2" || die "--rows must be greater than 0"
    rows="$2"
    shift 2
    ;;
  --start)
    require_arg "$@"
    start_value="$2"
    shift 2
    ;;
  --end)
    require_arg "$@"
    end_value="$2"
    shift 2
    ;;
  --padding)
    require_arg "$@"
    is_non_negative_int "$2" || die "--padding must be 0 or greater"
    padding="$2"
    shift 2
    ;;
  --margin)
    require_arg "$@"
    is_non_negative_int "$2" || die "--margin must be 0 or greater"
    margin="$2"
    shift 2
    ;;
  --background)
    require_arg "$@"
    background="$2"
    shift 2
    ;;
  --thumb-width)
    require_arg "$@"
    is_positive_int "$2" || die "--thumb-width must be greater than 0"
    thumb_width="$2"
    shift 2
    ;;
  --thumb-height)
    require_arg "$@"
    is_positive_int "$2" || die "--thumb-height must be greater than 0"
    thumb_height="$2"
    shift 2
    ;;
  -q | --quality)
    require_arg "$@"
    is_quality "$2" || die "--quality must be between 1 and 100"
    quality="$2"
    shift 2
    ;;
  --format)
    require_arg "$@"
    case "$2" in
    auto | jpg | jpeg | png | webp) format="$2" ;;
    *) die "--format must be auto, jpg, jpeg, png, or webp" ;;
    esac
    shift 2
    ;;
  --hwaccel)
    require_arg "$@"
    case "$2" in
    none | videotoolbox) hwaccel="$2" ;;
    *) die "--hwaccel must be none or videotoolbox" ;;
    esac
    shift 2
    ;;
  --ffmpeg)
    require_arg "$@"
    ffmpeg_bin="$2"
    shift 2
    ;;
  --ffprobe)
    require_arg "$@"
    ffprobe_bin="$2"
    shift 2
    ;;
  --magick)
    require_arg "$@"
    magick_bin="$2"
    shift 2
    ;;
  --overwrite)
    overwrite=1
    shift
    ;;
  --print-command)
    print_command=1
    shift
    ;;
  --verbose)
    verbose=1
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --)
    shift
    [[ $# -gt 0 ]] || die "missing input"
    input="$1"
    shift
    ;;
  -*)
    die "unknown option: $1"
    ;;
  *)
    [[ -z "$input" ]] || die "only one input file is supported"
    input="$1"
    shift
    ;;
  esac
done

[[ -n "$input" ]] || die "missing input"
[[ -f "$input" ]] || die "input not found: $input"
[[ -n "$ffmpeg_bin" ]] || die "missing dependency: ffmpeg"
[[ -n "$ffprobe_bin" ]] || die "missing dependency: ffprobe"
[[ -n "$magick_bin" ]] || die "missing dependency: magick"
need_command "$ffmpeg_bin"
need_command "$ffprobe_bin"
need_command "$magick_bin"

if [[ -z "$output" ]]; then
  output="$(default_output "$input" "$format")"
fi

if [[ -e "$output" && "$overwrite" -eq 0 ]]; then
  die "output exists: $output"
fi

duration="$(ffprobe_duration "$ffprobe_bin" "$input")"
start_seconds="$(resolve_time "$start_value" "$duration")"
end_seconds="$(resolve_time "$end_value" "$duration")"

awk -v start="$start_seconds" 'BEGIN { exit(start < 0 ? 0 : 1) }' && die "--start resolves below 0"
end_seconds="$(awk -v end="$end_seconds" -v duration="$duration" 'BEGIN { if (end > duration) end = duration; printf "%.12f\n", end }')"
awk -v start="$start_seconds" -v end="$end_seconds" 'BEGIN { exit(end <= start ? 0 : 1) }' && die "--end must resolve after --start"

if [[ -z "$rows" ]]; then
  rows="$(count_rows "$count" "$columns")"
fi

awk -v rows="$rows" -v columns="$columns" -v count="$count" 'BEGIN { exit(rows * columns < count ? 0 : 1) }' && die "--rows * --columns must be at least --count"

sample_duration="$(awk -v start="$start_seconds" -v end="$end_seconds" 'BEGIN { printf "%.12f\n", end - start }')"
fps="$(awk -v count="$count" -v sample_duration="$sample_duration" 'BEGIN { printf "%.12f\n", count / sample_duration }')"

filters=("trim=start=${start_seconds}:end=${end_seconds}" "setpts=PTS-STARTPTS" "fps=${fps}" "setsar=1")

if [[ -n "$thumb_width" && -n "$thumb_height" ]]; then
  filters+=("scale=${thumb_width}:${thumb_height}:force_original_aspect_ratio=decrease")
elif [[ -n "$thumb_width" ]]; then
  filters+=("scale=${thumb_width}:-1")
elif [[ -n "$thumb_height" ]]; then
  filters+=("scale=-1:${thumb_height}")
fi

filters+=("tile=${columns}x${rows}:padding=${padding}:margin=${margin}:color=${background}")

filtergraph=
for filter in "${filters[@]}"; do
  if [[ -n "$filtergraph" ]]; then
    filtergraph+=","
  fi
  filtergraph+="$filter"
done

output_format="$(format_from_output "$format" "$output")"

mkdir -p "$(dirname "$output")"
temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/generate-video-thumbnails.XXXXXX")"
trap 'rm -rf "$temp_dir"' EXIT
sheet="$temp_dir/sheet.png"

command=("$ffmpeg_bin" "-hide_banner" "-v" "error" "-y")
if [[ "$hwaccel" != "none" ]]; then
  command+=("-hwaccel" "$hwaccel")
fi
command+=("-i" "$input" "-vf" "$filtergraph" "-frames:v" "1" "$sheet")

if [[ "$print_command" -eq 1 || "$verbose" -eq 1 ]]; then
  printf '%q ' "${command[@]}"
  printf '\n'
fi

if [[ "$verbose" -eq 1 ]]; then
  printf 'duration=%s start=%s end=%s count=%s columns=%s rows=%s output=%s\n' \
    "$duration" "$start_seconds" "$end_seconds" "$count" "$columns" "$rows" "$output"
fi

"${command[@]}"

read -r image_width image_height < <("$magick_bin" identify -format '%w %h\n' "$sheet")
cell_width=$(((image_width - 2 * margin - (columns - 1) * padding) / columns))
cell_height=$(((image_height - 2 * margin - (rows - 1) * padding) / rows))
point_size=$((cell_height / 18))
if ((point_size < 12)); then
  point_size=12
fi
inset=$((point_size / 3))

annotate_command=(
  "$magick_bin" "$sheet"
  "-font" "/System/Library/Fonts/Monaco.ttf"
  "-pointsize" "$point_size"
  "-fill" "white"
  "-undercolor" "#000000B3"
  "-gravity" "northwest"
)

for ((index = 0; index < count; index++)); do
  column=$((index % columns))
  row=$((index / columns))
  x=$((margin + column * (cell_width + padding) + inset))
  y=$((margin + row * (cell_height + padding) + inset))
  annotate_command+=("-annotate" "+${x}+${y}" "$(format_timestamp "$start_seconds" "$sample_duration" "$count" "$index")")
done

annotate_command+=("-quality" "$quality" "${output_format}:$output")

if [[ "$print_command" -eq 1 || "$verbose" -eq 1 ]]; then
  printf '%q ' "${annotate_command[@]}"
  printf '\n'
fi

"${annotate_command[@]}"

if [[ "$verbose" -eq 1 ]]; then
  printf '%s\n' "$output"
fi
